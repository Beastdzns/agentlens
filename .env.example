GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
CORS_ORIGINS=*
PORT=8000

# --- Storage backend ---
# Set to "sqlite" to use the SQLite backend (used by run_demo.py)
# Leave unset or set to "memory" to use the default in-memory store
AGENTLENS_STORAGE=memory

# Path to the SQLite database file (only used when AGENTLENS_STORAGE=sqlite)
# Defaults to ./agentlens.db in the current working directory
AGENTLENS_DB_PATH=./agentlens.db

# --- Observation Policy ---
# "full" (default) = no transformation, all events stored as-is (no-op, D6).
# "adaptive"       = score each event and route it to the appropriate level.
AGENTLENS_OBSERVATION_POLICY=full

# Score thresholds for adaptive mode (score in [0, 1]):
#   score >= compress_threshold  -> FULL
#   score >= metadata_threshold  -> COMPRESSED  (payload truncated)
#   score >= drop_threshold      -> METADATA_ONLY (payload nulled)
#   score <  drop_threshold      -> DROP (skeleton only)
AGENTLENS_COMPRESS_THRESHOLD=0.60
AGENTLENS_METADATA_THRESHOLD=0.35
AGENTLENS_DROP_THRESHOLD=0.15

# Maximum payload size in bytes for COMPRESSED events (default 4096 = 4 KB)
AGENTLENS_PAYLOAD_MAX_BYTES=4096
